# ─────────────────────────────────────────────────────────────
#  Condominio ANPR — configuración
#  Copia este archivo a  .env  y ajusta los valores.
# ─────────────────────────────────────────────────────────────

# Clave secreta para firmar tokens (QR y sesiones). CAMBIALA.
SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria

# Usuario administrador inicial (se crea al arrancar si no existe).
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esto

# Base de datos (SQLite por defecto; sirve para 1 condominio).
DATABASE_URL=sqlite:///./data/condominio.db

# Carpeta donde se guardan las fotos que envía la cámara.
SNAPSHOT_DIR=./data/snapshots

# ─── Cámara / control de barrera ────────────────────────────
# Modo de control de barrera:
#   dahua  -> abre la barrera vía CGI de la cámara Dahua ITC (relé a bordo)
#   http   -> hace un GET/POST a una URL genérica (otro relé de red)
#   dummy  -> no abre nada, solo registra (para pruebas)
GATE_MODE=dummy

# Datos de la cámara Dahua (necesarios si GATE_MODE=dahua)
DAHUA_HOST=192.168.1.108
DAHUA_USER=admin
DAHUA_PASSWORD=
DAHUA_CHANNEL=1

# Para GATE_MODE=http (relé genérico)
GATE_HTTP_URL=

# ─── Reconocimiento de placas ───────────────────────────────
# Token opcional que la cámara debe enviar en el evento para
# aceptarlo (?token=... o header X-ANPR-Token). Vacío = sin verificar.
ANPR_INGEST_TOKEN=

# Si la placa NO está en la lista blanca, ¿abrir igual? (registro abierto)
OPEN_ON_UNKNOWN_PLATE=false
